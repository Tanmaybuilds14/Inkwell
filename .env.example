[TEMPLATE]
# Template only — copy to `.env` (gitignored) and fill in real values.
# Every key the app reads is listed here.

# ---- Database (NeonDB / local Postgres via docker-compose) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inkwell?schema=public"

# ---- Clerk (https://dashboard.clerk.com) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/documents"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/documents"

# ---- Sync service (WebSocket) ----
# Public ws(s):// URL the browser connects to
NEXT_PUBLIC_SYNC_WS_URL="ws://localhost:1234"
# Port the sync service listens on (server-side)
SYNC_PORT="1234"

# ---- Redis (Upstash / local docker-compose) ----
# Also backs the API rate limits; without it they fall back to per-process
# counters (correct for a single instance, N× looser behind a load balancer).
REDIS_URL="redis://localhost:6379"

# ---- Error reporting (optional; unset = console only) ----
# Server-side Sentry DSN. Sentry is only initialised when this is set, so a
# deployment without it behaves exactly as before and nothing is sent from a
# developer's machine.
SENTRY_DSN=""
# The browser SDK needs its own public key; SENTRY_DSN is not visible client-side.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional: label reports ("production"/"preview") and sample rate (0 = off).
SENTRY_ENVIRONMENT=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"

# ---- Rate limiting ----
# Set to 1 ONLY when a trusted proxy (Vercel, Fly, an ingress) overwrites
# X-Forwarded-For for you. The header is attacker-controlled when the app is
# reached directly, so API rate limiting keys share-link attempts by document
# unless this is enabled.
TRUST_PROXY=""

# ---- Inngest (background jobs; dev defaults work with the local dev server) ----
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ---- Resend (invite emails; optional in dev — emails are logged if unset) ----
RESEND_API_KEY=""
EMAIL_FROM="Inkwell <invites@yourdomain.com>"

# ---- App ----
# Public origin used to build share links and invite URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
