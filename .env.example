[TEMPLATE]
# Template only — copy to `.env` (gitignored) and fill in real values.
# Every key the app reads is listed here.

# ---- Database (NeonDB / local Postgres via docker-compose) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inkwell?schema=public"

# ---- Clerk (https://dashboard.clerk.com) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/documents"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/documents"

# ---- Sync service (WebSocket) ----
# Public ws(s):// URL the browser connects to
NEXT_PUBLIC_SYNC_WS_URL="ws://localhost:1234"
# Port the sync service listens on (server-side)
SYNC_PORT="1234"

# ---- Redis (Upstash / local docker-compose) ----
# Also backs the API rate limits; without it they fall back to per-process
# counters (correct for a single instance, N× looser behind a load balancer).
REDIS_URL="redis://localhost:6379"

# ---- Error reporting (optional; unset = console only) ----
# Server-side Sentry DSN. Sentry is only initialised when this is set, so a
# deployment without it behaves exactly as before and nothing is sent from a
# developer's machine.
SENTRY_DSN=""
# The browser SDK needs its own public key; SENTRY_DSN is not visible client-side.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional: label reports ("production"/"preview") and sample rate (0 = off).
SENTRY_ENVIRONMENT=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"

# ---- Rate limiting ----
# Set to 1 ONLY when a trusted proxy (Vercel, Fly, an ingress) overwrites
# X-Forwarded-For for you. The header is attacker-controlled when the app is
# reached directly, so API rate limiting keys share-link attempts by document
# unless this is enabled.
TRUST_PROXY=""

# ---- Load/perf testing (NEVER enable on a deployment reachable from the internet) ----
# PERF_TEST=1 massively raises every rate limit (multiplier, default 10,000x)
# and disables the WS handshake throttle so a load generator can open sockets.
# PERF_TEST_STUB_CLERK=1 (requires PERF_TEST=1) additionally skips Clerk JWT
# verification on the sync-service handshake: any token connects as the doc's
# OWNER with a deterministic test identity. Authorization/edit gating stay real.
# PERF_TEST_RATE_MULTIPLIER overrides the default 10,000x limit scaling.
PERF_TEST=""
PERF_TEST_STUB_CLERK=""
PERF_TEST_RATE_MULTIPLIER=""

# ---- Inngest (background jobs; dev defaults work with the local dev server) ----
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ---- Resend (invite emails; optional in dev — emails are logged if unset) ----
RESEND_API_KEY=""
EMAIL_FROM="Inkwell <invites@yourdomain.com>"

# ---- RAG chatbot (/RAG/PLAN.md) ----
# Embeddings: OpenRouter, OpenAI-compatible /embeddings. Free tier — see PLAN §7/§12
# for the data-retention caveat before using it with sensitive documents.
RAG_EMBEDDING_BASE_URL="https://openrouter.ai/api/v1"
RAG_EMBEDDING_API_KEY=""          # usually OPENROUTER_API_KEY
RAG_EMBEDDING_MODEL="nvidia/nemotron-3.5-embed-1b:free"
RAG_EMBEDDING_DIMENSIONS="1024"
RAG_EMBEDDING_BATCH="32"

# Answer generation: Google AI Studio (native REST, no SDK).
# NOTE: gemini-2.5-flash returns 404 for new keys; keep this in env, never hard-code.
RAG_LLM_PROVIDER="gemini"
RAG_LLM_MODEL="gemini-3.6-flash"
RAG_LLM_FALLBACK_MODELS="gemini-3.5-flash,gemini-3.8-flash"
RAG_LLM_MAX_OUTPUT_TOKENS="1024"
RAG_LLM_THINKING_BUDGET="0"        # 0 = fastest; raise for a "deep answer" mode
GEMINI_API_KEY=""

# Rerank: OpenRouter; set RAG_RERANK_ENABLED=0 to skip it entirely.
RAG_RERANK_ENABLED="1"
RAG_RERANK_BASE_URL="https://openrouter.ai/api/v1"
RAG_RERANK_MODEL="nvidia/nemotron-3.5-rerank-8b:free"
RAG_RERANK_TOP_N="8"
RAG_RERANK_TIMEOUT_MS="3000"

# Shared secret for POST /api/internal/rag/reindex (sync-service freshness hook
# and `npm run rag:reindex`). Generate one: openssl rand -hex 32
RAG_REINDEX_SECRET=""

# ---- App ----
# Public origin used to build share links and invite URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
